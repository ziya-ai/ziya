        "interpolate": {
         "value": "monotone"
        },
        "x": {
         "scale": "x",
         "field": "x"
        },
        "y": {
         "scale": "y",
         "field": "y0"
        },
        "y2": {
         "scale": "y",
         "field": "y1"
        },
        "fill": {
         "scale": "color",
         "field": "c"
        },
        "fillOpacity": {
         "value": 0.85
        }
       }
      }
     }
    ]
   }
