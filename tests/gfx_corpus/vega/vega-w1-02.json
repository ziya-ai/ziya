     "data": "series",
     "field": "x"
    }
   },
   {
    "name": "y",
    "type": "linear",
    "range": "height",
    "nice": true,
    "zero": true,
    "domain": {
     "data": "series",
     "field": "y1"
    }
   },
   {
    "name": "color",
    "type": "ordinal",
    "range": "category",
    "domain": {
