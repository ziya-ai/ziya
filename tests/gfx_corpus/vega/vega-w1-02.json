   {
    "orient": "left",
    "scale": "y",
    "title": "Volume",
    "grid": true
   }
  ],
  "legends": [
   {
    "fill": "color",
    "title": "Region",
    "orient": "right"
   }
  ],
  "marks": [
   {
    "type": "group",
    "from": {
     "facet": {
      "name": "facetSeries",
      "data": "series",
      "groupby": "c"
     }
    },
    "marks": [
     {
      "type": "area",
      "from": {
