     {
      "c": "alpha",
      "v": 31
     },
     {
      "c": "beta",
      "v": 58
     },
     {
      "c": "gamma",
      "v": 24
     },
     {
      "c": "delta",
      "v": 47
     },
     {
      "c": "epsilon",
      "v": 66
     },
     {
      "c": "zeta",
      "v": 39
     }
    ]
   }
  ],
  "scales": [
