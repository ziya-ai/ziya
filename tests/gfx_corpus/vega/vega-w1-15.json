{
 "type": "vega",
 "definition": {
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 440,
  "height": 230,
  "padding": 5,
  "data": [
   {
    "name": "raw",
    "values": [
     {
      "t": 4
     },
