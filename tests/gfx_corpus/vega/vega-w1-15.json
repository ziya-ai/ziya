     {
      "t": 52
     },
     {
      "t": 58
     },
     {
      "t": 63
     },
     {
      "t": 71
     }
    ]
   },
   {
    "name": "binned",
    "source": "raw",
    "transform": [
     {
      "type": "bin",
      "field": "t",
      "extent": [
       0,
       80
      ],
      "step": 8,
      "as": [
       "b0",
       "b1"
      ]
     },
     {
      "type": "aggregate",
      "groupby": [
       "b0",
       "b1"
      ],
      "ops": [
       "count"
      ],
      "as": [
       "n"
      ]
     }
    ]
   },
   {
    "name": "stats",
    "source": "raw",
    "transform": [
     {
      "type": "aggregate",
      "fields": [
       "t"
      ],
      "ops": [
       "mean"
      ],
      "as": [
       "mu"
      ]
     }
    ]
   }
  ],
  "scales": [
   {
    "name": "x",
    "type": "linear",
    "domain": [
     0,
     80
    ],
    "range": "width",
    "zero": true
   },
   {
    "name": "y",
    "type": "linear",
    "domain": {
     "data": "binned",
     "field": "n"
    },
    "nice": true,
    "zero": true,
    "range": "height"
   }
  ],
  "axes": [
   {
    "orient": "bottom",
    "scale": "x",
    "title": "Duration (s)",
    "tickCount": 10
   },
   {
    "orient": "left",
    "scale": "y",
    "title": "Count",
    "grid": true,
    "tickMinStep": 1
   }
  ],
  "marks": [
   {
    "type": "rect",
    "from": {
     "data": "binned"
    },
    "encode": {
     "enter": {
      "x": {
       "scale": "x",
       "field": "b0"
      },
      "x2": {
       "scale": "x",
       "field": "b1",
       "offset": -1
      },
      "y": {
       "scale": "y",
       "field": "n"
      },
      "y2": {
       "scale": "y",
       "value": 0
      },
      "fill": {
       "value": "#6a8caf"
      },
      "stroke": {
       "value": "#33506b"
      },
      "strokeWidth": {
       "value": 0.6
      }
     }
    }
   },
   {
    "type": "rule",
    "from": {
     "data": "stats"
    },
    "encode": {
     "enter": {
      "x": {
       "scale": "x",
       "field": "mu"
      },
      "y": {
       "value": 0
      },
      "y2": {
       "signal": "height"
      },
      "stroke": {
       "value": "#b5651d"
      },
      "strokeWidth": {
       "value": 2
      }
     }
    }
   },
   {
    "type": "text",
    "from": {
     "data": "stats"
    },
    "encode": {
     "enter": {
      "x": {
       "scale": "x",
       "field": "mu",
       "offset": 6
      },
      "y": {
       "value": 12
      },
      "align": {
       "value": "left"
      },
      "fontSize": {
       "value": 11
      },
      "fontWeight": {
       "value": "bold"
      },
      "fill": {
       "value": "#b5651d"
      },
      "text": {
       "signal": "'mean ' + format(datum.mu, '.1f') + 's'"
      }
     }
    }
   }
  ]
 },
 "intent": "Histogram: `bin` + `aggregate` transforms producing binned counts, drawn as rect marks, with a second aggregate stream driving a mean rule and its label. Exercises the data-transform pipeline plus cross-dataset signal-free annotation."
}
