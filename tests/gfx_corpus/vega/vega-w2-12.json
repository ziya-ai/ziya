{
 "type": "vega",
 "definition": {
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 700,
  "height": 560,
  "padding": 5,
  "autosize": "none",
  "signals": [
   {
    "name": "cx",
    "update": "width / 2"
   },
   {
    "name": "cy",
    "update": "height / 2"
   }
  ],
  "data": [
   {
    "name": "nodes",
    "transform": [
     {
      "type": "sequence",
      "start": 0,
      "stop": 300,
      "step": 1,
      "as": "i"
     },
     {
      "type": "formula",
      "as": "grp",
      "expr": "datum.i % 20"
     }
    ]
   },
   {
    "name": "edges",
    "transform": [
     {
      "type": "sequence",
      "start": 0,
      "stop": 600,
      "step": 1,
      "as": "i"
     },
     {
      "type": "formula",
      "as": "source",
      "expr": "datum.i % 300"
     },
     {
      "type": "formula",
      "as": "target",
      "expr": "(datum.i * 7 + 13) % 300"
     }
    ]
   }
  ],
  "scales": [
   {
    "name": "c",
    "type": "ordinal",
    "domain": {
     "data": "nodes",
     "field": "grp"
    },
    "range": {
     "scheme": "category10"
    }
   }
  ],
  "marks": [
   {
    "name": "nodeMark",
    "type": "symbol",
    "zindex": 1,
    "from": {
     "data": "nodes"
    },
    "encode": {
     "enter": {
      "fill": {
       "scale": "c",
       "field": "grp"
      },
      "stroke": {
       "value": "#ffffff"
      },
      "strokeWidth": {
       "value": 0.3
      },
      "size": {
       "value": 30
      }
     }
    },
    "transform": [
     {
      "type": "force",
      "iterations": 200,
      "signal": "force",
      "static": true,
      "forces": [
       {
        "force": "center",
        "x": {
         "signal": "cx"
        },
        "y": {
         "signal": "cy"
        }
       },
       {
        "force": "collide",
        "radius": 4
       },
       {
        "force": "nbody",
        "strength": -6
       },
       {
        "force": "link",
        "links": "edges",
        "distance": 18
       }
      ]
     }
    ]
   },
   {
    "type": "path",
    "from": {
     "data": "edges"
    },
    "encode": {
     "update": {
      "stroke": {
       "value": "#7f8c9b"
      },
      "strokeWidth": {
       "value": 0.3
      }
     }
    },
    "transform": [
     {
      "type": "linkpath",
      "require": {
       "signal": "force"
      },
      "shape": "line",
      "sourceX": "datum.source.x",
      "sourceY": "datum.source.y",
      "targetX": "datum.target.x",
      "targetY": "datum.target.y"
     }
    ]
   }
  ]
 },
 "intent": "SCALE/COUNT + LAYOUT COST: force-directed graph with 300 nodes and 600 links, 20 groups over a 10-hue scheme (2x recycling). Probes iterative layout at scale and hairline link visibility per theme."
}
