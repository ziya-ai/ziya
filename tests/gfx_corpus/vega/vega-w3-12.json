{
 "type": "vega",
 "definition": {
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 780,
  "height": 470,
  "padding": 5,
  "autosize": {
   "type": "fit",
   "contains": "padding"
  },
  "title": {
   "text": "Gradient fills: linear (→#ffffff), radial, plus gradient legend",
   "fontSize": 14
  },
  "data": [
   {
    "name": "t",
    "values": [
     {
      "c": "one",
      "v": 40
     },
     {
      "c": "two",
      "v": 62
     },
     {
      "c": "three",
      "v": 28
     },
     {
      "c": "four",
      "v": 51
     }
    ]
   }
  ],
  "scales": [
   {
    "name": "x",
    "type": "band",
    "domain": {
     "data": "t",
     "field": "c"
    },
    "range": "width",
    "padding": 0.25
   },
   {
    "name": "y",
    "type": "linear",
    "domain": [
     0,
     70
    ],
    "range": "height",
    "nice": true
   },
   {
