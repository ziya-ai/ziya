        ]
       }
      },
      "stroke": {
       "value": "#cccccc"
      }
     }
    }
   },
   {
    "type": "arc",
    "encode": {
     "enter": {
      "x": {
       "signal": "width*0.5"
      },
      "y": {
       "signal": "height*0.3"
      },
      "startAngle": {
       "value": 0
      },
      "endAngle": {
       "value": 6.283
      },
      "outerRadius": {
       "value": 52
      },
      "innerRadius": {
       "value": 0
      },
      "fill": {
       "value": {
        "gradient": "radial",
        "stops": [
         {
          "offset": 0,
          "color": "#ffffff"
         },
         {
          "offset": 1,
          "color": "#f1c40f"
         }
        ]
       }
      },
      "stroke": {
       "value": "#e0e0e0"
      }
     }
    }
   },
   {
    "type": "text",
    "from": {
     "data": "t"
    },
    "encode": {
     "enter": {
      "x": {
       "scale": "x",
       "field": "c",
       "band": 0.5
      },
      "y": {
       "scale": "y",
       "field": "v",
       "offset": 16
      },
      "text": {
       "field": "v"
      },
      "align": {
       "value": "center"
      },
      "fill": {
       "value": "#ffffff"
      },
      "fontSize": {
       "value": 13
      }
     }
    }
   }
  ]
 },
 "intent": "COLOR: linear and radial gradient fills on rect and arc marks, plus a gradient-filled area and a gradient legend, where every stop is a hardcoded light-anchored colour ending in #ffffff."
}
