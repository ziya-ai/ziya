    }
   }
  ],
  "axes": [
   {
    "orient": "bottom",
    "scale": "x",
    "title": "bar"
   },
   {
    "orient": "left",
    "scale": "y",
    "grid": true,
    "title": "value"
   }
  ],
  "legends": [
   {
    "fill": "ramp",
    "type": "gradient",
    "title": "lightgreyred ramp"
   }
  ],
  "marks": [
   {
    "type": "rect",
    "from": {
     "data": "t"
    },
    "encode": {
     "enter": {
      "x": {
       "scale": "x",
       "field": "c"
      },
      "width": {
       "scale": "x",
       "band": 1
      },
      "y": {
       "scale": "y",
       "field": "v"
      },
      "y2": {
       "scale": "y",
       "value": 0
      },
      "fill": {
       "value": {
        "gradient": "linear",
        "x1": 0,
        "y1": 0,
        "x2": 0,
        "y2": 1,
        "stops": [
         {
          "offset": 0,
          "color": "#2c3e50"
         },
         {
          "offset": 0.6,
          "color": "#dfe6e9"
         },
         {
          "offset": 1,
          "color": "#ffffff"
