   },
   "y": {
    "field": "v",
    "type": "quantitative",
    "axis": {
     "title": "v"
    }
   }
  }
 },
 "intent": "ASPECT: extreme wide-and-short - authored height 40 against ~1180px width (~30:1); can the plot survive its axis furniture?"
}
